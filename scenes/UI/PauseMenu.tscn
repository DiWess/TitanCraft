[gd_scene load_steps=2 format=3 uid="uid://titancraft_pause_menu"]

[ext_resource type="Script" path="res://src/UI/PauseMenu.cs" id="1_pause"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_pause")

[node name="Panel" type="PanelContainer" parent="."]
offsets_preset = 8
offset_left = 460.0
offset_top = 140.0
offset_right = 820.0
offset_bottom = 560.0

[node name="Menu" type="VBoxContainer" parent="Panel"]

[node name="Title" type="Label" parent="Panel/Menu"]
text = "Paused"
horizontal_alignment = 1

[node name="Controls" type="Label" parent="Panel/Menu"]
theme_override_colors/font_color = Color(0.83, 0.8, 0.72, 1)
theme_override_font_sizes/font_size = 14
text = "WASD / ZQSD — move
Mouse — look
Space — jump
E — interact, craft at the workbench
Left click — attack, once the Mk I is built
Esc — pause"
metadata/notes = "The controls reference; the HUD teaches controls step by step through the onboarding prompt"

[node name="ResumeButton" type="Button" parent="Panel/Menu"]
text = "Resume"

[node name="SaveButton" type="Button" parent="Panel/Menu"]
text = "Save"

[node name="MainMenuButton" type="Button" parent="Panel/Menu"]
text = "Return to Main Menu"

[node name="QuitButton" type="Button" parent="Panel/Menu"]
text = "Quit"

[connection signal="pressed" from="Panel/Menu/ResumeButton" to="." method="Resume"]
[connection signal="pressed" from="Panel/Menu/SaveButton" to="." method="SaveGame"]
[connection signal="pressed" from="Panel/Menu/MainMenuButton" to="." method="ReturnToMainMenu"]
[connection signal="pressed" from="Panel/Menu/QuitButton" to="." method="QuitGame"]
[connection signal="mouse_entered" from="Panel/Menu/ResumeButton" to="." method="PlayHoverSound"]
[connection signal="mouse_entered" from="Panel/Menu/SaveButton" to="." method="PlayHoverSound"]
[connection signal="mouse_entered" from="Panel/Menu/MainMenuButton" to="." method="PlayHoverSound"]
[connection signal="mouse_entered" from="Panel/Menu/QuitButton" to="." method="PlayHoverSound"]
